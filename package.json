{
  "name": "wildcards-manager",
  "version": "0.9.3",
  "private": true,
  "description": "Desktop manager to visualize, validate, edit, refactor, and analyze Dynamic Prompts wildcard libraries",
  "author": "Wildcards Manager",
  "homepage": "https://github.com/aipower66669/WildcardsManager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aipower66669/WildcardsManager.git"
  },
  "bugs": {
    "url": "https://github.com/aipower66669/WildcardsManager/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "bump:patch": "node scripts/bump-patch.mjs",
    "clean:old-releases": "node scripts/clean-old-releases.mjs",
    "build:win": "npm run build && electron-builder --win --publish never",
    "dist": "npm run bump:patch && npm run build && electron-builder --publish never && npm run clean:old-releases",
    "dist:nobump": "npm run build:win && npm run clean:old-releases",
    "dist:win": "npm run bump:patch && npm run build:win && npm run clean:old-releases",
    "dist:mac": "npm run bump:patch && npm run build && electron-builder --mac --publish never && npm run clean:old-releases",
    "dist:linux": "npm run bump:patch && npm run build && electron-builder --linux --publish never && npm run clean:old-releases"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dagrejs/dagre": "^3.0.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@xyflow/react": "^12.6.4",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.511.0",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "36.9.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "build": {
    "appId": "com.wildcardsmanager.app",
    "productName": "Wildcards Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sample_wildcards",
        "to": "sample_wildcards"
      },
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "icon": "resources/icon.png",
    "artifactName": "WildcardsManager-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "resources/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true
  }
}
